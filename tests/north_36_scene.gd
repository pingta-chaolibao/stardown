extends "res://tests/north_02_scene.gd"
func _cell(a:Array)->Vector2i:return Vector2i(a[0],a[1])
func _run()->void:
	root.size=Vector2i(1280,820);game=load("res://scenes/main.tscn").instantiate();root.add_child(game);await _settle();await _click("Level36")
	_check(game.current_level_index==35 and game.model.level.id=="north_hero_36" and game.LEVEL_TITLES[35]=="第三十六关","36realpooledcardandtitle")
	_check(game.model.player==Vector2i(2,3) and game.model.active_kind()=="blue" and game.model.level.swap_hero_color=="purple","purpleexchangeheroexactinitial")
	_check(game.find_child("SelectedHero",true,false).text.contains("紫色"),"UIlabelsconfirmedpurpleherowithsameexchangeability")
	_check(game.menu.strip.card_for_index(35)._role_color("blue")==game.board.HERO_PURPLE,"pooledcardpreviewandrolechipalsopurple")
	_check(game.board._mechanism_tint(true)==game.board.MECHANISM_RED and game.board._mechanism_tint(false)==game.board.GOLD,"redclear/yellowpressurepaletteindependent")
	var initial:Dictionary=game.model.snapshot();_check_layout(game);await _capture("north_36_initial.png")
	var key:=InputEventKey.new();key.keycode=KEY_A;key.physical_keycode=KEY_A;key.pressed=true;Input.parse_input_event(key);await _settle();var once:Dictionary=game.model.snapshot()
	for echo in [true,false,true]:key.echo=echo;Input.parse_input_event(key);await _settle();_check(game.model.snapshot()==once and game.model.moves==1,"held/echoignored")
	key.pressed=false;Input.parse_input_event(key);await _settle();await _click("Undo");_check(game.model.snapshot()==initial,"screenUndo")
	await _press(KEY_C);_check(game.model.snapshot()==initial and game.model.history_size()==0,"singleheroCfree")
	for s in "DRU":await _press(_keycode(s))
	var safe:Dictionary=game.model.snapshot();await _click("MoveRight");_check(not game.model.alive and game.model.death_reason=="monster","actuallegaldangerdeath")
	var dead:Dictionary=game.model.snapshot();await _press(KEY_C);await _press(KEY_R);await _click("BackToLevels");_check(game.model.snapshot()==dead and not game.menu.visible,"deathcannotbypassC/restart/menu")
	await _capture("north_36_death.png");await _click("Undo");_check(game.model.snapshot()==safe and game.model.alive,"onlyUndorevives");await _click("Restart")
	var proof:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://artifacts/verification/north_36_route.json"));var sol:Dictionary=proof["solution"];var history:Array[Dictionary]=[]
	for i in sol["path"].length():
		var symbol:String=sol["path"][i];var before:Dictionary=game.model.snapshot();history.append(before)
		if i%5==0:await _click({"U":"MoveUp","D":"MoveDown","L":"MoveLeft","R":"MoveRight"}[symbol])
		else:await _press(_keycode(symbol))
		var row:Dictionary=proof["trace"][i]
		_check(game.model.alive and game.model.player==_cell(row["player"]) and game.model.moves==i+1 and game.model.swaps==int(row["swaps"]),"actualkeyboard/screenmatchesindependentstate")
		for id in row["crystals"]:_check(game.model.crate_id(_cell(row["crystals"][id]))==int(id),"crystalidentity")
		_check(game.model.monsters()[0]["position"]==_cell(row["goblin"]) and game.model.monsters()[0]["alive"]==row["goblin_alive"],"Goblinidentity/life")
		_check(game.model.barrier_is_active(Vector2i(5,1))==row["yellow_active"] and game.model.barrier_is_active(Vector2i(7,3))==row["red_active"],"separateconditionsandcolors")
		if i+1 in [8,15,18,20,24]:await _capture("north_36_action_%02d.png" % (i+1))
		if i==20:
			var cleared:Dictionary=game.model.snapshot();_check(game.model.living_monster_count()==0 and not game.model.pressure_is_active("yellow_01") and not game.model.barrier_is_active(Vector2i(7,3)),"21restorationkillsGoblinandopensclearonly")
			await _capture("north_36_clear_open.png");await _click("Undo");_check(game.model.snapshot()==before and game.model.living_monster_count()==1 and not game.model.barrier_is_active(Vector2i(5,1)) and game.model.barrier_is_active(Vector2i(7,3)) and game.board.feedback.plan.is_empty(),"UndorevivesGoblinandbothmechanismswithoutstaleeffects")
			await _capture("north_36_undo_revived.png");await _press(_keycode(symbol));_check(game.model.snapshot()==cleared,"redo21deterministic")
	_check(game.model.is_complete() and game.moves_label.text=="26" and game.swaps_label.text=="08" and game.model.crates().size()==2,"26/8livingvictory")
	await _capture("north_36_completed.png");await _click("Undo");_check(game.model.snapshot()==history[-1] and not game.model.is_complete(),"victoryUndo")
	await _click("Restart");root.size=Vector2i(960,615);await _settle();_check_layout(game);await _capture("north_36_compact.png")
	await _click("BackToLevels");_check(game.menu.strip.item_count == 40 and game.menu.strip.pool.size()<=game.menu.strip.capacity_bound(),"39realentriesboundedpool")
	await _capture("north_36_navigation.png");await _click("Level35");_check(game.model.active_kind()=="red" and game.model.level.swap_hero_color=="blue","olddefaultpresentationuntouched");await _click("Level09");_check(game.menu.strip.card_for_index(8)._role_color("blue")==game.board.HERO_BLUE,"oldbluecardremainsblue");await _click("Level36");_check(game.model.snapshot()==initial and game.model.history_size()==0,"35/09/36historyisolation")
	print("NORTH36 SCENE RESULT: %d checks,%d failures;display=%s" % [checks,failures,DisplayServer.get_name()]);quit(0 if failures==0 else 1)
