extends "res://tests/north_02_scene.gd"
const Events40=preload("res://scripts/view/feedback_events.gd")
func _run()->void:
	root.size=Vector2i(1280,820);game=load("res://scenes/main.tscn").instantiate();root.add_child(game);await _settle();await _click("Level40")
	_check(game.current_level_index==39 and game.model.level.id=="north_hero_40" and game.LEVEL_TITLES[39]=="第四十关","real pooled40 entry and chapter title")
	_check(game.model.active_kind()=="yellow" and game._hero_color_name()=="黄" and game._hero_tint()==game.board.HERO_YELLOW,"yellow visual identity/UI naming")
	_check(game.pushes_label==null and game.pulls_label==null and game.swaps_label==null and game.find_child("SelectedHero",true,false).text.contains("黄"),"no misleading push/pull/swap ability stats")
	var initial:Dictionary=game.model.snapshot();_check_layout(game);await _capture("north_40_initial.png")
	await _press(KEY_C);await _press(KEY_Z);_check(game.model.snapshot()==initial and game.model.history_size()==0,"single-hero C and emptyUndo no action/attack")
	await _press(KEY_S);var blocked:Dictionary=game.model.snapshot();await _click("MoveDown")
	_check(game.model.snapshot()==blocked and game.status_label.text.contains("不能推拉") and game.model.moves==1,"actual screen input cannot push lower crystal")
	await _click("Undo");_check(game.model.snapshot()==initial,"Undo real move after blocked input")
	var key:=InputEventKey.new();key.keycode=KEY_D;key.physical_keycode=KEY_D;key.pressed=true;Input.parse_input_event(key);await _settle();var once:Dictionary=game.model.snapshot()
	for echo in [true,false,true]:key.echo=echo;Input.parse_input_event(key);await _settle();_check(game.model.snapshot()==once and game.model.moves==1,"held/echo do not repeat movement or shields")
	key.pressed=false;Input.parse_input_event(key);await _settle();await _click("Undo");_check(game.model.snapshot()==initial,"keyboard release plus screen Undo")
	var proof:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://artifacts/verification/north_40_route.json"));var last_before:Dictionary={}
	for row in proof["trace"]:
		last_before=game.model.snapshot();var capture:Dictionary=Events40.capture(game.model);var symbol:String=row["input"];var n:int=row["action"]
		if n%4==0:await _click({"U":"MoveUp","D":"MoveDown","L":"MoveLeft","R":"MoveRight"}[symbol])
		else:await _press(_keycode(symbol))
		_check(game.model.alive and game.model.player==Vector2i(row["player"][0],row["player"][1]) and game.model.moves==n and game.model.protected_heroes()==[true],"actual keyboard/screen route agrees with independent trace")
		_check(game.model.living_monster_count()==7 and game.model.crates().size()==5 and game.model.pushes==0 and game.model.pulls==0 and game.model.swaps==0,"all objects stationary and no unrequested capabilities")
		var plan:Dictionary=Events40.action(capture,game.model,{"U":Vector2i.UP,"D":Vector2i.DOWN,"L":Vector2i.LEFT,"R":Vector2i.RIGHT}[symbol])
		_check(plan["fire"].is_empty() and plan["goblin"].is_empty() and plan["deaths"].is_empty() and plan["shields"].size()==row["blocked_goblins"].size()+(1 if row["fire_shield"] else 0),"real attack blocks yield only shield feedback")
		_check(game.model.is_complete()==(n==17),"no premature victory")
		if n in [2,7,8,10,13,16]:await _capture("north_40_action_%02d.png"%n)
		if n in [2,10]:
			var after:Dictionary=game.model.snapshot();await _click("Undo");_check(game.model.snapshot()==last_before and game.board.feedback.plan.is_empty(),"Undo cancels shield remnants and restores exact state")
			await _press(_keycode(symbol));_check(game.model.snapshot()==after,"redo exact shield geometry")
	_check(game.model.is_complete() and game.moves_label.text=="17" and game.model.player==Vector2i(2,3),"yellow reaches30 in17actual walks")
	await _capture("north_40_completed.png");await _click("Undo");_check(game.model.snapshot()==last_before and not game.model.is_complete(),"victory Undo restores actual prior action")
	await _click("Restart");root.size=Vector2i(960,615);await _settle();_check_layout(game);await _capture("north_40_compact.png")
	await _click("BackToLevels");_check(game.menu.strip.item_count==game.LEVEL_PATHS.size() and game.menu.strip.pool.size()<=game.menu.strip.capacity_bound(),"40 catalog entries remain pooled")
	await _capture("north_40_navigation.png");await _click("Level39");_check(not game.model.protected_heroes().has(true) and game.model.level.pressure_colors()==["blue","yellow"],"yellow immunity never leaks into old39")
	await _click("Level40");_check(game.model.snapshot()==initial,"return40 restores pristine state")
	game.queue_free();await process_frame
	game=load("res://scenes/main.tscn").instantiate();game.start_in_level=true;game.level_path="res://tests/fixtures/yellow_protection.json";root.add_child(game);root.size=Vector2i(1280,820);await _settle()
	_check(game.model.level.is_temporary and game.model.active_kind()=="green" and game.model.protected_heroes()==[true,true,false],"clearly separate fixture: inactive yellow protects red,far green not immune")
	_check_layout(game);await _capture("north_40_fixture_ally.png");await _press(KEY_D);_check(game.model.alive and game.model.player==Vector2i(6,1) and game.model.fire_rays()[0].get("shielded_hero")==1,"red shield screens farther hero during real input")
	await _press(KEY_C);_check(game.model.active_kind()=="yellow" and game.model.moves==1,"fixture freeC does not advance attacks")
	var safe:Dictionary=game.model.snapshot();await _press(KEY_A);_check(not game.model.alive and not game.model.hero_is_alive(1) and game.model.hero_is_alive(0),"real protector movement exposes diagonal red to fire")
	var dead:Dictionary=game.model.snapshot();await _press(KEY_C);await _press(KEY_R);await _click("BackToLevels");_check(game.model.snapshot()==dead and not game.menu.visible,"new protection death still only Undo,no C/menu/restart escape")
	await _capture("north_40_fixture_death.png");await _click("Undo");_check(game.model.snapshot()==safe and game.model.alive and game.model.active_kind()=="yellow" and game.board.feedback.plan.is_empty(),"Undo restores ally shield and keeps current selection")
	root.size=Vector2i(960,615);await _settle();_check_layout(game);await _capture("north_40_fixture_compact.png")
	print("NORTH40 SCENE RESULT: %d checks,%d failures;display=%s"%[checks,failures,DisplayServer.get_name()]);quit(0 if failures==0 else 1)
