extends "res://tests/north_02_scene.gd"
func _run() -> void:
	root.size=Vector2i(1280,820);game=load("res://scenes/main.tscn").instantiate();root.add_child(game)
	await _settle();await _click("Level33")
	_check(game.LEVEL_TITLES.size()==game.LEVEL_PATHS.size() and game.LEVEL_TITLES[32]=="第三十三关","sidebarandcatalogtitlecomplete")
	_check(game.current_level_index==32 and game.model.level.id=="north_hero_33" and game.model.level.width==12 and game.model.level.height==7,"pooled33card opensconfirmed12x7")
	_check(game.model.player==Vector2i(2,3) and game.model.active_kind()=="red" and game.model.living_monster_count()==3,"initialheroandthreeGoblins")
	_check(game.model.level.monster_kinds==PackedStringArray(["goblin","goblin","goblin"]) and game.board._mechanism_tint()==game.board.MECHANISM_RED,"18Goblin,redclearenergytint")
	var initial:Dictionary=game.model.snapshot();_check_layout(game);await _capture("north_33_initial.png")
	var key:=InputEventKey.new();key.keycode=KEY_S;key.physical_keycode=KEY_S;key.pressed=true
	Input.parse_input_event(key);await _settle();var once:Dictionary=game.model.snapshot()
	for echo in [true,false,true]:
		key.echo=echo;Input.parse_input_event(key);await _settle();_check(game.model.snapshot()==once and game.model.moves==1,"held/echo doesnotrepeat")
	key.pressed=false;Input.parse_input_event(key);await _settle();await _click("Undo")
	_check(game.model.snapshot()==initial,"screenUndo actualstep")
	await _press(KEY_C);_check(game.model.snapshot()==initial and game.model.history_size()==0,"singleheroCfree")
	await _click("MoveLeft");_check(not game.model.alive and game.model.death_reason=="monster","screeninputGoblin18 killscardinalneighbor")
	var dead:Dictionary=game.model.snapshot();await _press(KEY_C);await _press(KEY_R);await _click("BackToLevels")
	_check(game.model.snapshot()==dead and not game.menu.visible,"deathcannotbypassC/restart/menu")
	await _click("Undo");_check(game.model.alive and game.model.snapshot()==initial,"onlyUndo revives");await _click("Restart")
	for symbol in "DDDRRRRRUUU":await _press(_keycode(symbol))
	var gate:Dictionary=game.model.snapshot();await _click("MoveRight")
	_check(game.model.snapshot()==gate and game.model.barrier_is_active(Vector2i(8,3)) and game.status_label.text.contains("清怪能量"),"blockedcleargate explainscondition,noextraattack")
	await _capture("north_33_gate_blocked.png");await _click("Restart")
	var solution:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://levels/solutions/north_33.json"))
	var proof:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://artifacts/verification/north_33_route.json"))
	var history:Array[Dictionary]=[]
	for i in solution["path"].length():
		var symbol:String=solution["path"][i];var before:Dictionary=game.model.snapshot();history.append(before)
		await _press(_keycode(symbol));var expected:Dictionary=proof["trace"][i]
		_check(game.model.alive and game.model.moves==i+1 and game.model.player==_cell(expected["player"]) and game.model.pushes==expected["pushes"],"actualkeyboardmatchesindependenttrace")
		for identity in 2:_check(game.model.crate_id(_cell(expected["crystals"][identity]))==identity,"crystalidentity")
		for identity in 3:_check(game.model.monsters()[identity]["position"]==_cell(expected["monsters"][identity]) and game.model.monsters()[identity]["alive"]==expected["monster_alive"][identity],"Goblinidentitypositionlife")
		_check(game.model.barrier_is_active(Vector2i(8,3))==expected["barrier_active"] and game.model.is_complete()==(i==67),"gate/goal timing")
		if i in [13,35,50,56]:await _capture("north_33_action_%02d.png" % (i+1))
		if i==57:
			var cleared:Dictionary=game.model.snapshot();_check(game.model.living_monster_count()==0 and game.progress_label.text.contains("0 / 3"),"threeGoblinsdieatonce")
			await _capture("north_33_clear_open.png");await _click("Undo")
			_check(game.model.snapshot()==before and game.model.living_monster_count()==3 and game.model.barrier_is_active(Vector2i(8,3)) and game.board.feedback.plan.is_empty(),"Undo revivesallthree andsolidgate")
			await _capture("north_33_undo_revived.png");await _press(_keycode(symbol));_check(game.model.snapshot()==cleared,"repeat58deterministic")
	_check(game.model.is_complete() and game.moves_label.text=="68" and game.model.pushes==21 and game.model.crates().size()==2,"actual68directions21pushlivingvictory")
	await _capture("north_33_completed.png");await _click("Undo")
	_check(game.model.snapshot()==history[-1] and not game.model.is_complete(),"victoryUndo")
	await _click("Restart");root.size=Vector2i(960,615);await _settle();_check_layout(game);await _capture("north_33_compact.png")
	await _click("BackToLevels");_check(game.menu.strip.item_count == 40 and game.menu.strip.pool.size()<=game.menu.strip.capacity_bound(),"37entry preservespoolednavigation")
	await _capture("north_33_navigation.png");await _click("Level32");await _click("Level33")
	_check(game.model.snapshot()==initial and game.model.history_size()==0 and game.model.barrier_is_active(Vector2i(8,3)),"32/33UIhistory/life/clearstatesisolated")
	print("NORTH33 SCENE RESULT: %d checks,%d failures;display=%s" % [checks,failures,DisplayServer.get_name()]);quit(0 if failures==0 else 1)
func _cell(a:Array) -> Vector2i:return Vector2i(a[0],a[1])
