extends "res://tests/north_05_scene.gd"
## Actual green single-pull and three-plate AND inputs, no extra mechanics.

func _run() -> void:
	root.size=Vector2i(1280,820)
	game=load("res://scenes/main.tscn").instantiate()
	root.add_child(game)
	await _settle()
	await _click("Level08")
	_check(game.current_level_index==7 and game.model.level.id=="north_hero_08" and game.model.player==Vector2i(1,1),"GUI selects confirmed green eighth level")
	_check(game.model.crates().size()==3 and game.model.level.bushes.size()==3 and game.model.pressure_progress("yellow_01")==Vector2i(0,3),"three crystals, three bushes and three empty plates")
	var initial: Dictionary=game.model.snapshot()
	await _capture("north_08_initial.png")
	await _press(KEY_D)
	_check(game.model.snapshot()==initial and game.status_label.text.contains("不能推"),"normal green key cannot push first crystal")
	await _held_key_check()
	await _click("Restart")
	_check(game.model.snapshot()==initial and game.model.history_size()==0,"eighth restart clears duplicate-input setup")
	var solution: Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://levels/solutions/north_08.json"))
	var before_final: Dictionary
	for index in solution["path"].length():
		before_final=game.model.snapshot()
		await _press(_keycode(solution["path"][index]))
		_check(game.model.moves==index+1 and game.model.alive and game.model.pushes==0,"actual eighth keyboard step %d" % (index+1))
		if index in [6,8,52]:
			var before: Dictionary=game.model.snapshot()
			var depth: int=game.model.history_size()
			await _press(KEY_D if index==8 else KEY_A)
			_check(game.model.snapshot()==before and game.model.history_size()==depth and game.status_label.text.contains("草丛"),"each real bush rejects normal key without movement or pull")
			if index==6:await _capture("north_08_bush_blocked.png")
		if index==50:
			_check(game.model.player==Vector2i(5,4) and game.model.pressure_progress("yellow_01")==Vector2i(3,3) and not game.model.blocks_sight(Vector2i(6,1)),"real hero plus two crystals open energy movement/sight")
			await _capture("north_08_hero_plate.png")
			var held: Dictionary=game.model.snapshot()
			await _press(KEY_S)
			_check(game.model.barrier_is_active(Vector2i(6,1)) and game.model.blocks_sight(Vector2i(6,1)) and game.model.pressure_progress("yellow_01")==Vector2i(2,3),"actual release closes gate when one plate empties")
			await _capture("north_08_pressure_released.png")
			await _press(KEY_Z)
			_check(game.model.snapshot()==held,"actual undo restores exact open state before continuing legal route")
		if index==51:
			_check(game.model.crate_id(Vector2i(5,4))>=0 and game.model.pressure_progress("yellow_01")==Vector2i(3,3) and not game.model.barrier_is_active(Vector2i(6,1)),"third crystal replaces hero pressure atomically")
			_check(game.progress_label.text.contains("黄板 3 / 3"),"UI shows all three plates pressed")
			await _capture("north_08_all_plates.png")
		if index==54:
			_check(game.model.player==Vector2i(6,1),"real hero traverses open energy cell")
			await _capture("north_08_crossing.png")
	_check(game.model.is_complete() and game.model.player==Vector2i(6,0) and game.model.moves==56 and game.model.pulls==17,"eighth normal keyboard victory uses 56 moves and 17 pulls")
	_check(game.moves_label.text=="56" and game.pulls_label.text=="17" and game.status_label.text.contains("已抵达终点"),"visible eighth victory statistics")
	await _capture("north_08_completed.png")
	await _click("Undo")
	_check(game.model.snapshot()==before_final and not game.model.is_complete(),"eighth GUI victory undo restores full preceding state")
	await _click("Restart")
	_check(game.model.snapshot()==initial and game.model.history_size()==0,"eighth GUI restart restores full initial state")
	await _click("Level07")
	_check(game.model.level.bushes.is_empty() and game.model.crates().size()==1 and game.model.barrier_states().size()==2 and game.model.history_size()==0,"eighth objects and history do not leak into seventh")
	await _press(KEY_S)
	await _click("Level08")
	await _press(KEY_Z)
	_check(game.model.snapshot()==initial and game.undo_button.disabled,"seventh undo history does not enter eighth")
	await _green_death_fixture()
	await _click("Level08")
	_check(game.model.snapshot()==initial,"existing independent death/undo fixture leaves real eighth state clean")
	_check_layout(game)
	root.size=Vector2i(960,615)
	await _settle()
	_check_layout(game)
	await _capture("north_08_compact.png")
	print("NORTH 08 SCENE RESULT: %d checks, %d failures; display=%s" % [checks,failures,DisplayServer.get_name()])
	game.queue_free()
	await process_frame
	quit(0 if failures==0 else 1)
