extends "res://tests/north_02_scene.gd"
const DIR_KEYS={"U":KEY_UP,"D":KEY_DOWN,"L":KEY_LEFT,"R":KEY_RIGHT,"C":KEY_C}
func _run() -> void:
	root.size=Vector2i(1280,820)
	game=preload("res://scenes/main.tscn").instantiate();root.add_child(game)
	await _settle();await _click("Level17")
	_check(game.current_level_index==16 and game.model.hero_count()==3 and game.model.active_hero_id()=="blue","UI loads confirmed17 with blue selected")
	_check(game.find_child("Objective",true,false).text=="三名英雄分占不同终点" and game.model.crates().size()==4,"three goals/4crystals, no color pairing")
	for name in ["Moves","Pushes","Pulls","Swaps"]:_check(game.find_child(name,true,false)!=null,"all three abilities have statistics")
	_check_layout(game)
	await _capture("north_17_initial.png")
	var initial:Dictionary=game.model.snapshot()
	await _click("SwitchHero")
	_check(game.model.active_hero_id()=="red" and game.model.snapshot()==initial,"screen C blue->red, free selection")
	await _capture("north_17_selected_red.png")
	await _click("SwitchHero")
	_check(game.model.active_hero_id()=="green" and game.model.snapshot()==initial,"screen C red->green, free selection")
	await _capture("north_17_selected_green.png")
	await _press(KEY_Z)
	_check(game.model.snapshot()==initial and game.model.active_hero_id()=="green","empty undo skips control selections")
	await _press(KEY_R)
	_check(game.model.active_hero_id()=="blue" and game.model.snapshot()==initial,"restart default blue with original four crystal IDs")
	await _repeated_inputs()
	await _press(KEY_R)
	var solution:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://levels/solutions/north_17.json"))
	var actions:=0;var choices:=0
	for symbol in solution["path"]:
		var before:Dictionary=game.model.snapshot()
		await _press(DIR_KEYS[symbol])
		if symbol=="C":
			choices+=1
			_check(game.model.snapshot()==before,"actual C selection never counts or writes history")
		else:actions+=1
		_check(game.model.moves==actions and game.model.history_size()==actions and game.model.alive,"actual action counts and all heroes alive")
		_check(game.model.is_complete()==(actions==66),"no early victory before3different hero goals")
		if symbol!="C":
			if actions==14:await _capture("north_17_all_plates.png")
			if actions==20:await _capture("north_17_crystals_on_energy.png")
			if actions==21 or actions==53:
				var expected:=2 if actions==21 else 1
				_check(game.model.crates().size()==expected and game.status_label.text.contains("摧毁"),"actual restoration removes crystals and explains consequence")
				await _capture("north_17_first_destruction.png" if actions==21 else "north_17_second_destruction.png")
				var after:Dictionary=game.model.snapshot()
				await _click("SwitchHero")
				var selected:String=game.model.active_hero_id()
				await _press(KEY_Z)
				_check(game.model.snapshot()==before and game.model.active_hero_id()==selected,"actual undo restores destroyed identities while retaining newly selected hero")
				await _choose("blue")
				await _press(DIR_KEYS[symbol])
				_check(game.model.snapshot()==after,"actual repeated restoration deterministic")
			if actions==25:await _capture("north_17_green_escape.png")
			if actions==33:await _capture("north_17_top_crystal_pull.png")
			if actions==52:await _capture("north_17_second_crystal_on_energy.png")
			if actions==57:await _capture("north_17_first_goal.png")
			if actions==63:await _capture("north_17_two_goals.png")
	_check(actions==66 and choices==15 and game.model.pushes==2 and game.model.pulls==11 and game.model.swaps==3 and game.model.crates().size()==1,"actual66actions+15freeC,2push11pull3swap and3destroyed")
	_check(game.model.occupied_exits()==3 and game.status_label.text.contains("三英雄"),"three-hero victory UI")
	await _capture("north_17_completed.png")
	await _press(KEY_Z);_check(not game.model.is_complete() and game.model.moves==65 and game.model.active_hero_id()=="blue","victory undo retains blue")
	await _press(KEY_R);_check(game.model.snapshot()==initial,"victory restart restores destroyed crystals")
	await _death_inputs()
	await _click("Level16");_check(game.current_level_index==15 and game.model.hero_count()==2 and game.model.level.exit_color=="purple" and game.model.history_size()==0,"previous16 selection/goal/history isolated")
	await _click("Level17");_check(game.model.snapshot()==initial and game.model.active_hero_id()=="blue","back to17 resets all3heroes4crystals")
	root.size=Vector2i(960,615);await _settle();_check_layout(game)
	await _capture("north_17_compact_blue.png")
	await _click("SwitchHero");_check(game.model.active_hero_id()=="red" and game.model.snapshot()==initial,"compact true mouse selects red")
	_check_layout(game);await _capture("north_17_compact_red.png")
	await _click("SwitchHero");_check(game.model.active_hero_id()=="green" and game.model.snapshot()==initial,"compact true mouse selects green")
	_check_layout(game);await _capture("north_17_compact_green.png")
	await _click("SwitchHero");_check(game.model.active_hero_id()=="blue" and game.model.moves==0 and game.model.history_size()==0,"compact full3hero cycle remains free")
	print("NORTH 17 SCENE RESULT: %d checks, %d failures; display=%s" % [checks,failures,DisplayServer.get_name()])
	quit(0 if failures==0 else 1)
func _choose(id:String) -> void:
	for _i in 3:
		if game.model.active_hero_id()==id:return
		await _press(KEY_C)
	_check(false,"requested hero exists")
func _repeated_inputs() -> void:
	var initial:Dictionary=game.model.snapshot()
	var event:=InputEventKey.new();event.keycode=KEY_C;event.physical_keycode=KEY_C;event.pressed=true
	Input.parse_input_event(event);await _settle();_check(game.model.active_hero_id()=="red" and game.model.snapshot()==initial,"fresh C free selection")
	event.echo=true;Input.parse_input_event(event);await _settle();event.echo=false;Input.parse_input_event(event);await _settle()
	_check(game.model.active_hero_id()=="red" and game.model.snapshot()==initial,"C echo and held duplicates cannot cycle repeatedly")
	event.pressed=false;Input.parse_input_event(event);await _settle();await _press(KEY_C)
	_check(game.model.active_hero_id()=="green" and game.model.snapshot()==initial,"released fresh C advances one hero")
	await _press(KEY_R)
	var up:=InputEventKey.new();up.keycode=KEY_UP;up.physical_keycode=KEY_UP;up.pressed=true
	Input.parse_input_event(up);await _settle();var first:Dictionary=game.model.snapshot()
	up.echo=true;Input.parse_input_event(up);await _settle();up.echo=false;Input.parse_input_event(up);await _settle()
	_check(game.model.moves==1 and game.model.player==Vector2i(2,3) and game.model.snapshot()==first,"direction echo and held duplicates do not repeat")
	up.pressed=false;Input.parse_input_event(up);await _settle();await _press(KEY_UP)
	_check(game.model.moves==2 and game.model.player==Vector2i(2,2) and not game.model.is_complete(),"new direction press walks,1of3goals not victory")
func _death_inputs() -> void:
	await _press(KEY_R)
	var solution:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://levels/solutions/north_17.json"))
	for symbol in solution["path"]:
		if game.model.moves>=15:break
		await _press(DIR_KEYS[symbol])
	await _choose("green");await _press(KEY_UP);await _press(KEY_UP);await _choose("blue")
	var before:Dictionary=game.model.snapshot()
	await _press(KEY_UP)
	_check(not game.model.alive and not game.model.hero_is_alive(0) and game.model.crate_id(Vector2i(8,2))==-1,"legal side input kills inactive green and destroys right crystal together")
	await _capture("north_17_death_and_destruction.png")
	var dead:Dictionary=game.model.snapshot()
	await _press(KEY_C);await _press(KEY_R);await _press(KEY_RIGHT);await _click("Level16")
	_check(game.model.snapshot()==dead and game.current_level_index==16,"anyhero death preventsC/R/directions/level bypass")
	await _press(KEY_Z)
	_check(game.model.snapshot()==before and game.model.active_hero_id()=="blue" and game.model.hero_is_alive(0) and game.model.crate_id(Vector2i(8,2))==2,"actual undo restores destroyed right crystal and revives inactive green")
	await _capture("north_17_revived_and_restored.png")
	await _press(KEY_R)
